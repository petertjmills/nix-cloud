{
  "import": [],
  "provider": {
    "incus": {}
  },
  "resource": {
    "incus_instance": {
      "cumulonimbus": {
        "config": {},
        "device": [
          {
            "name": "zfs_storage",
            "properties": {
              "path": "/zfs_data",
              "pool": "tank",
              "source": "zfs_tank_1tb"
            },
            "type": "disk"
          },
          {
            "name": "lvm_storage",
            "properties": {
              "path": "/lvm_data",
              "pool": "lvm",
              "source": "lvm_500gb"
            },
            "type": "disk"
          },
          {
            "name": "enp1s0",
            "properties": {
              "ipv4.address": "10.0.0.4",
              "name": "enp1s0",
              "network": "incusbr0"
            },
            "type": "nic"
          }
        ],
        "image": "nixos-lxc-base",
        "limits": {},
        "name": "cumulonimbus",
        "type": "container"
      },
      "cumulus": {
        "config": {
          "boot.autostart": true,
          "security.nesting": true
        },
        "device": [
          {
            "name": "root",
            "properties": {
              "path": "/",
              "pool": "lvm",
              "size": "50GiB"
            },
            "type": "disk"
          },
          {
            "name": "enp1s0",
            "properties": {
              "ipv4.address": "10.0.0.2",
              "name": "enp1s0",
              "network": "incusbr0"
            },
            "type": "nic"
          }
        ],
        "image": "nixos-lxc-base",
        "limits": {
          "cpu": 2,
          "memory": "4GiB"
        },
        "name": "cumulus",
        "type": "container"
      },
      "nimbostratus": {
        "config": {},
        "device": [
          {
            "name": "gpu",
            "properties": {
              "address": "0000:00:02.0"
            },
            "type": "pci"
          },
          {
            "name": "root",
            "properties": {
              "path": "/",
              "pool": "lvm",
              "size": "50GiB"
            },
            "type": "disk"
          },
          {
            "name": "enp1s0",
            "properties": {
              "ipv4.address": "10.0.0.5",
              "name": "enp1s0",
              "network": "incusbr0"
            },
            "type": "nic"
          }
        ],
        "image": "nixos-vm-base",
        "limits": {
          "cpu": 4,
          "memory": "4GiB"
        },
        "name": "nimbostratus",
        "type": "virtual-machine"
      },
      "stratocumulus": {
        "config": {
          "boot.autostart": true
        },
        "device": [
          {
            "name": "enp1s0",
            "properties": {
              "ipv4.address": "10.0.0.3",
              "name": "enp1s0",
              "network": "incusbr0"
            },
            "type": "nic"
          }
        ],
        "image": "nixos-lxc-base",
        "limits": {},
        "name": "stratocumulus",
        "type": "container"
      }
    },
    "incus_network_forward": {
      "cumulonimbus_forward": {
        "config": {
          "target_address": "10.0.0.4"
        },
        "listen_address": "192.168.86.195",
        "network": "incusbr0",
        "provisioner": {
          "local-exec": {
            "command": "ssh root@192.168.86.192 \"ip addr add 192.168.86.195/24 dev br0\""
          }
        }
      },
      "cumulus_forward": {
        "config": {
          "target_address": "10.0.0.2"
        },
        "listen_address": "192.168.86.193",
        "network": "incusbr0",
        "provisioner": {
          "local-exec": {
            "command": "ssh root@192.168.86.192 \"ip addr add 192.168.86.193/24 dev br0\""
          }
        }
      },
      "nimbostratus_forward": {
        "config": {
          "target_address": "10.0.0.5"
        },
        "listen_address": "192.168.86.196",
        "network": "incusbr0",
        "provisioner": {
          "local-exec": {
            "command": "ssh root@192.168.86.192 \"ip addr add 192.168.86.196/24 dev br0\""
          }
        }
      },
      "stratocumulus_forward": {
        "config": {
          "target_address": "10.0.0.3"
        },
        "listen_address": "192.168.86.194",
        "network": "incusbr0",
        "provisioner": {
          "local-exec": {
            "command": "ssh root@192.168.86.192 \"ip addr add 192.168.86.194/24 dev br0\""
          }
        }
      }
    },
    "incus_storage_pool": {
      "homeserver_lvm": {
        "config": {
          "size": "800GiB"
        },
        "driver": "lvm",
        "name": "lvm"
      }
    },
    "incus_storage_volume": {
      "homeserver_lvm_500gb": {
        "config": {
          "size": "500GiB"
        },
        "name": "lvm_500gb",
        "pool": "lvm"
      },
      "homeserver_zfs_tank_1tb": {
        "config": {
          "size": "1TiB"
        },
        "name": "zfs_tank_1tb",
        "pool": "tank"
      }
    }
  },
  "terraform": {
    "required_providers": {
      "incus": {
        "source": "registry.terraform.io/lxc/incus"
      }
    }
  }
}
